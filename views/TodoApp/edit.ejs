<%- include('../includes/header') %>
    <h1><%= title %></h1>
    <% if (error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>
    <form action="/todos/<%= todo.id %>/update" method="POST" novalidate>
        <div>
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" value="<%= error ? todo.title : todo.title %>" required>
        </div>
        <div>
            <label for="text">Text:</label>
            <textarea id="text" name="text" required><%= error ? todo.text : todo.text %></textarea>
        </div>
        <button type="submit">Update Todo</button>
    </form>

    <p>
        <a href="/todos">Back to Todos</a>

    </p>
<%- include('../includes/footer') %>   