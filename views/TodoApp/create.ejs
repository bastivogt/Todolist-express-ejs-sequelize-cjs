<%- include('../includes/header') %>
    <h1><%= title %></h1>
    <% if (error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>
    <form action="/todos/store" method="POST" novalidate>
        <div>
            <label for="title">Title:</label>
            <input type="text" id="title" name="title" required value="<%= error ? todo.title : '' %>">
        </div>
        <div>
            <label for="text">Text:</label>
            <textarea id="text" name="text" required><%= error ? todo.text : '' %></textarea>
        </div>
        <button type="submit">Create Todo</button>
    </form>

    <p>
        <a href="/todos">Back to Todos</a>

    </p>
<%- include('../includes/footer') %>   